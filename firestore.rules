rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'todofiesta2425@gmail.com' ||
        request.auth.token.email == 'admin@nexo360.com'
      );
    }

    function getUserDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSystemAdmin() {
      return isBootstrappedAdmin() || (
        hasUserDoc() && (
          getUserDoc(request.auth.uid).role == 'propietario' ||
          getUserDoc(request.auth.uid).role == 'administrador'
        ) && getUserDoc(request.auth.uid).active == true
      );
    }

    function isOrgMember(orgId) {
      return isBootstrappedAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)) ||
          (hasUserDoc() && getUserDoc(request.auth.uid).tenantId == orgId)
        )
      );
    }

    function isOrgAdminOrOwner(orgId) {
      return isSystemAdmin() || (
        isOrgMember(orgId) && (
          (exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)) &&
            (get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data.role in ['propietario', 'administrador'])) ||
          (hasUserDoc() && getUserDoc(request.auth.uid).tenantId == orgId &&
            getUserDoc(request.auth.uid).role in ['propietario', 'administrador'])
        )
      );
    }

    function canWriteCommercial(orgId) {
      return isOrgMember(orgId);
    }

    // Root user profiles collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSystemAdmin());
      allow list: if isSystemAdmin();
      
      // Prevent self-privilege escalation during registration
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
        && incoming().id == userId
        && incoming().email is string
        && (
          isBootstrappedAdmin() || 
          incoming().role in ['empleado', 'solo_lectura']
        );

      // Only admins can alter roles; users can update their own display name
      allow update: if isSignedIn() && isValidId(userId) && (
        isSystemAdmin() || (
          request.auth.uid == userId &&
          incoming().id == existing().id &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastActive'])
        )
      );

      allow delete: if isBootstrappedAdmin() && userId != request.auth.uid;
    }

    // Organizations collection
    match /organizations/{orgId} {
      allow get: if isOrgMember(orgId);
      allow create: if isSignedIn() && isValidId(orgId) && incoming().ownerUid == request.auth.uid;
      allow update: if isOrgAdminOrOwner(orgId) && incoming().ownerUid == existing().ownerUid;
      allow delete: if false;

      // Users subcollection within organization
      match /users/{userId} {
        allow get, list: if isOrgMember(orgId);
        allow create: if isOrgAdminOrOwner(orgId) && isValidId(userId);
        allow update: if isOrgAdminOrOwner(orgId);
        allow delete: if isOrgAdminOrOwner(orgId) && userId != request.auth.uid;
      }

      // Products subcollection
      match /products/{productId} {
        allow get, list: if isOrgMember(orgId);
        allow create: if canWriteCommercial(orgId) && isValidId(productId) 
          && incoming().name is string && incoming().name.size() <= 150
          && incoming().salePrice is number && incoming().salePrice >= 0;
        allow update: if canWriteCommercial(orgId)
          && incoming().name is string && incoming().name.size() <= 150
          && incoming().salePrice is number && incoming().salePrice >= 0;
        allow delete: if isOrgAdminOrOwner(orgId);
      }

      // Clients subcollection
      match /clients/{clientId} {
        allow get, list: if isOrgMember(orgId);
        allow create, update: if canWriteCommercial(orgId) && isValidId(clientId)
          && incoming().name is string && incoming().name.size() <= 150;
        allow delete: if isOrgAdminOrOwner(orgId);
      }

      // Sales subcollection
      match /sales/{saleId} {
        allow get, list: if isOrgMember(orgId);
        allow create: if canWriteCommercial(orgId) && isValidId(saleId)
          && incoming().total is number && incoming().total >= 0
          && incoming().employeeId == request.auth.uid;
        allow update: if isOrgAdminOrOwner(orgId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'syncStatus', 'syncedAt']);
        allow delete: if false;
      }

      // Inventory movements subcollection
      match /inventory_movements/{movementId} {
        allow get, list: if isOrgMember(orgId);
        allow create: if canWriteCommercial(orgId) && isValidId(movementId)
          && incoming().quantity is number && incoming().quantity > 0
          && incoming().employeeId == request.auth.uid;
        allow update, delete: if false;
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow get, list: if isOrgMember(orgId);
        allow create: if canWriteCommercial(orgId) && isValidId(expenseId)
          && incoming().amount is number && incoming().amount > 0;
        allow update: if isOrgAdminOrOwner(orgId);
        allow delete: if isOrgAdminOrOwner(orgId);
      }
    }
  }
}
